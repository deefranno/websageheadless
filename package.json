{
  "name": "websage-headless",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @websage/contracts build && pnpm --filter @websage/wp-plugin build && pnpm --filter @websage/web build",
    "test:integration": "pnpm --filter @websage/web test:integration",
    "php:check": "composer --working-dir=packages/wp-plugin check"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "vitest": "5.0.5"
  }
}
