{
  "name": "websage-headless",
  "private": true,
  "version": "1.0.0-rc.1",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && pnpm --filter @websage/wp-plugin lint",
    "format": "prettier --write .",
    "dev:web": "pnpm --filter @websage/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @websage/contracts build && pnpm --filter @websage/wp-plugin build && pnpm --filter @websage/web build",
    "test:integration": "pnpm --filter @websage/web test:integration",
    "php:check": "composer --working-dir=packages/wp-plugin check",
    "version:check": "node scripts/version.mjs",
    "version:set": "node scripts/version.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
