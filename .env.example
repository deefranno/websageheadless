# Copy to apps/web/.env.local. Every value here is server-only: never add a
# NEXT_PUBLIC_ prefix to any of them.

# HTTPS origin of the WordPress site (no path). The frontend only ever calls
# this origin; it is never taken from request data.
WP_API_ORIGIN=https://websage-headless.ddev.site

# Public origin of this frontend.
FRONTEND_ORIGIN=http://localhost:3000

# Host serving WordPress uploads, read at build time for next/image and the
# CSP img-src. Changing it requires a rebuild.
WORDPRESS_MEDIA_HOST=websage-headless.ddev.site

# Local DDEV uses a mkcert certificate that Node does not trust by default.
# Point this at mkcert's root CA (run `mkcert -CAROOT` to find it). Do not
# disable TLS verification instead.
# NODE_EXTRA_CA_CERTS=/home/you/.local/share/mkcert/rootCA.pem

# Development-only: serve the shared contract fixtures instead of calling
# WordPress. Refused when NODE_ENV=production.
WSH_FIXTURE_MODE=false

# Phase 3/4 placeholders: use distinct random secrets when those features ship.
WSH_SERVER_API_SECRET=replace-before-use
WSH_PREVIEW_SECRET=replace-before-use
WSH_REVALIDATION_SECRET=replace-before-use
WSH_RATE_LIMIT_SECRET=replace-before-use

# Optional future spam protection; disabled by default.
TURNSTILE_SECRET_KEY=

# WordPress side (wp-config.php constant or server environment, not this file):
#   WSH_FRONTEND_ORIGIN=https://www.example.com   # HTTPS origin used for canonical URLs
