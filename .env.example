# Copy to apps/web/.env.local. All privileged values stay server-only.
WP_API_ORIGIN=https://websage-headless.ddev.site
FRONTEND_ORIGIN=http://localhost:3000
WORDPRESS_MEDIA_HOST=websage-headless.ddev.site
# Development fixtures only; rejected under NODE_ENV=production.
WSH_FIXTURE_MODE=false
# Phase 3/4 placeholders: use distinct random secrets when those integrations ship.
WSH_SERVER_API_SECRET=replace-before-use
WSH_PREVIEW_SECRET=replace-before-use
WSH_REVALIDATION_SECRET=replace-before-use
WSH_RATE_LIMIT_SECRET=replace-before-use
# Optional future spam protection; disabled by default.
TURNSTILE_SECRET_KEY=
