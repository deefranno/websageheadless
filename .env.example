# Copy to apps/web/.env.local (development) or set in your host's environment
# (production). Every value is server-only unless it starts with NEXT_PUBLIC_;
# never add that prefix to a secret.

# HTTPS origin of the WordPress site (no path). The frontend only ever calls
# this origin; it is never taken from request data.
WP_API_ORIGIN=https://websage-headless.ddev.site

# Public origin of this frontend. Used for redirects, canonical fallbacks and
# robots.txt. robots.txt is generated at build time: set this before building.
FRONTEND_ORIGIN=http://localhost:3000

# Host serving WordPress uploads (host[:port], no scheme), read at build time
# for next/image and the CSP img-src. Changing it requires a rebuild.
WORDPRESS_MEDIA_HOST=websage-headless.ddev.site

# Local WordPress with a self-signed or mkcert certificate: Node.js must be
# told about the CA in the SHELL that starts the server; this file is read too
# late for it. Never disable TLS checks instead.
#   NODE_EXTRA_CA_CERTS="$(mkcert -CAROOT)/rootCA.pem" pnpm --filter @websage/web dev

# Development only: render the shared contract fixtures instead of calling
# WordPress. Refused when NODE_ENV=production.
WSH_FIXTURE_MODE=false

# Shared secrets. Use a different random value for each, at least 32
# characters, for example: openssl rand -hex 32
# The first three must have the same values in WordPress (wp-config.php).
WSH_SERVER_API_SECRET=replace-before-use
WSH_PREVIEW_SECRET=replace-before-use
WSH_REVALIDATION_SECRET=replace-before-use
# Frontend only (keys the contact-form rate limit; WordPress never sees IPs).
WSH_RATE_LIMIT_SECRET=replace-before-use

# Which request header carries the visitor's real IP, set by YOUR proxy or
# host (contact-form rate limiting). Required in production; without it the
# form answers 503 rather than trust a forgeable header. Examples:
#   Vercel:            x-forwarded-for, hops 1
#   Cloudflare:        cf-connecting-ip
#   nginx/LiteSpeed:   x-forwarded-for, hops = number of proxies you run
# WSH_CLIENT_IP_HEADER=x-forwarded-for
# WSH_TRUSTED_PROXY_HOPS=1

# Optional Cloudflare Turnstile on the contact form; off unless both are set.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# WordPress side (wp-config.php constants or server environment, not this file):
#   define( 'WSH_FRONTEND_ORIGIN', 'https://www.example.com' );   # or WebSage Settings → Integration; http:// only for localhost
#   define( 'WSH_SERVER_API_SECRET', '…' );    # same values as above
#   define( 'WSH_PREVIEW_SECRET', '…' );
#   define( 'WSH_REVALIDATION_SECRET', '…' );
#   define( 'WSH_REVALIDATE_URL', 'https://internal-host/api/revalidate' );   # optional override
