{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "websage/cta-reference",
  "version": "1.0.0",
  "title": "Saved call to action",
  "category": "design",
  "icon": "megaphone",
  "description": "Shows a call to action from the Calls to action library.",
  "textdomain": "websage-headless",
  "attributes": {
    "schemaVersion": {
      "type": "integer"
    },
    "ctaId": {
      "type": "integer"
    },
    "theme": {
      "type": "string",
      "enum": ["default", "muted", "brand"],
      "default": "default"
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js"
}
