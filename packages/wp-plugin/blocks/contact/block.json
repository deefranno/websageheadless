{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "websage/contact",
  "version": "1.0.0",
  "title": "Contact form",
  "category": "design",
  "icon": "email",
  "description": "Contact form; messages go to the address in WebSage Settings.",
  "textdomain": "websage-headless",
  "attributes": {
    "schemaVersion": {
      "type": "integer"
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "submitLabel": {
      "type": "string",
      "default": ""
    },
    "successMessage": {
      "type": "string",
      "default": ""
    },
    "theme": {
      "type": "string",
      "enum": ["default", "muted", "brand"],
      "default": "default"
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "multiple": false
  },
  "editorScript": "file:./index.js"
}
