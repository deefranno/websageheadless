{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "websage/text-image",
  "version": "1.0.0",
  "title": "Text and image",
  "category": "design",
  "icon": "align-pull-left",
  "description": "Heading and text beside an image.",
  "textdomain": "websage-headless",
  "attributes": {
    "schemaVersion": {
      "type": "integer"
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "body": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "integer"
    },
    "position": {
      "type": "string",
      "enum": ["left", "right"],
      "default": "right"
    },
    "theme": {
      "type": "string",
      "enum": ["default", "muted", "brand"],
      "default": "default"
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js"
}
