includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
  level: 8
  phpVersion: 80100
  paths:
    - websage-headless-core.php
    - uninstall.php
    - src
  scanDirectories:
    - vendor/cmb2/cmb2/includes
  scanFiles:
    - tests/phpstan-wp-cli.php
  bootstrapFiles:
    - tests/phpstan-constants.php
